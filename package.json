{
  "name": "vms-postgresql",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite --host",
    "dev:server": "node --watch scripts/dev-server.mjs",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "db:init": "node scripts/init-db.mjs",
    "import:supabase": "node scripts/import-supabase.mjs",
    "sync:cloud": "node scripts/sync-supabase.mjs --watch",
    "sync:once": "node scripts/sync-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "connect-history-api-fallback": "^2.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.2",
    "socket.io-client": "^4.8.1",
    "sweetalert2": "^11.26.17",
    "sweetalert2-react-content": "^5.1.1",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.0",
    "vite-plugin-static-copy": "^3.1.2"
  },
  "description": "ระบบบันทึกผู้มาติดต่อพื้นที่ (VMS) แบบ Local ใช้ PostgreSQL, Express, Socket.IO และที่เก็บรูปบนเครื่อง Server",
  "main": "postcss.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piya48x/Vistor_TDK.git"
  },
