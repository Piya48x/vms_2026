# PostgreSQL
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_change_this_password
PGHOST=localhost
PGPORT=5432

# Server security - change both before production use
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_SECRET=change-this-to-a-random-string-at-least-32-characters
SESSION_HOURS=12
COOKIE_SECURE=false

# Runtime
PORT=3000
HOST=0.0.0.0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=8
# 0 disables automatic deletion. Set e.g. 90 only after retention is approved.
RETENTION_DAYS=0

# Frontend data source: local or supabase
VITE_DATA_MODE=local

# Add these values in Vercel (safe for the browser).
# VITE_DATA_MODE=supabase
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# VITE_SUPABASE_ANON_KEY=legacy_anon_key_if_your_project_still_uses_it
# VITE_SUPABASE_PHOTO_BUCKET=visitor-photos

# Add these only to .env on the office computer.
# Never add the service-role/secret key to Vercel or to a VITE_ variable.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_your_key
# SUPABASE_SERVICE_ROLE_KEY=legacy_service_role_key_if_needed
# SUPABASE_STORAGE_BUCKET=visitor-photos
# CLOUD_SYNC_INTERVAL_SECONDS=60

# ใส่เฉพาะช่วงย้ายข้อมูลเดิม แล้วลบออกหลังย้ายสำเร็จ
# MIGRATION_SUPABASE_URL=https://PROJECT.supabase.co
# MIGRATION_SUPABASE_ANON_KEY=your-old-anon-key

# Frontend branding / privacy notice
VITE_ORG_NAME=T.D.K. INDUSTRIAL
VITE_SITE_NAME=บริษัท ที.ดี.เค.อินดัสเตรียล จำกัด
VITE_PRIVACY_NOTICE_VERSION=2026-10-30
VITE_PRIVACY_RETENTION_DAYS=90
VITE_PRIVACY_CONTACT=กรุณาระบุช่องทางติดต่อผู้รับผิดชอบข้อมูลส่วนบุคคล
